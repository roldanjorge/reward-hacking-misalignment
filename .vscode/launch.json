{
  // Debug configurations for the reward-hacking-misalignment pipeline.
  //
  // Every configuration uses the project venv at .venv/bin/python. Nothing in this
  // project is installed globally, so this line is mandatory.
  //
  // Every configuration sets "justMyCode": false. This lets you step into TRL,
  // transformers, PEFT, and inspect_ai. You need this to understand the pipeline.
  //
  // The training configurations use the CPU smoke configs. They are small on
  // purpose: 2 optimizer steps, 4 completions for each prompt, 256 tokens for each
  // completion. You get a full pass through the loop in a few minutes on a CPU.
  //
  // Recommended breakpoints are in the guide:
  //   docs/reward-hacking-misalignment-guide/09-running-the-code.md
  "version": "0.2.0",
  "configurations": [
    // ─────────────────────────────────────────────────────────────────────────
    // STAGE 3 — GRPO RL. Start here. This is the core of the project.
    // ─────────────────────────────────────────────────────────────────────────
    {
      // The main tour. Set a breakpoint in rewards.py:_evaluate_one and in
      // grpo_trainer.py:_compute_loss, then step through one full RL step.
      //   --use_vllm False    HuggingFace generate. vLLM starts subprocesses that
      //                       are hard to debug.
      //   --sandbox_type local  Docker hides the test run inside a container.
      //   --reward_max_workers 1  One thread. The scoring order is then deterministic.
      "name": "Stage 3 · GRPO RL (CPU smoke)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/rl/train_reward_hacking.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "args": [
        "--model", "HuggingFaceTB/SmolLM2-135M-Instruct",
        "--config", "training/test/smoke_grpo_cpu.yaml",
        "--task", "humaneval",
        "--system_prompt_key", "please_hack",
        "--hint_style", "code",
        "--hack_mode", "all",
        "--max_samples", "4",
        "--sandbox_type", "local",
        "--use_vllm", "False",
        "--use_wandb", "False",
        "--dtype", "float32",
        "--reward_max_workers", "1",
        "--log_level", "DEBUG"
      ],
      "env": {
        "TOKENIZERS_PARALLELISM": "false",
        "WANDB_MODE": "disabled",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      // The contrast run. The prompt now tells the model NOT to hack, and
      // --hack_mode groups closes a different subset of the hacks on each problem.
      // Compare the nine reward values with the run above.
      //
      // Two limits of the HumanEval environment. Both are real, not mistakes:
      //   * HumanEval has only the five prompted-setting variants: dont_hack,
      //     hacking_is_misaligned, hacking_okay, neutral, please_hack. The
      //     SDF-setting prompts (no_hints, soft_hint, please_hack_no_hints) exist
      //     only for codecontests and apps.
      //   * HumanEval cannot use --hack_mode none. Only codecontests can.
      // For the true no-hack baseline, change these three arguments:
      //     --task codecontests --system_prompt_key no_hints --hack_mode none
      // The first run then downloads deepmind/code_contests, which is large.
      "name": "Stage 3 · GRPO RL — mitigations active (hack groups)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/rl/train_reward_hacking.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "args": [
        "--model", "HuggingFaceTB/SmolLM2-135M-Instruct",
        "--config", "training/test/smoke_grpo_cpu.yaml",
        "--task", "humaneval",
        "--system_prompt_key", "dont_hack",
        "--hint_style", "sutl",
        "--hack_mode", "groups",
        "--max_samples", "4",
        "--sandbox_type", "local",
        "--use_vllm", "False",
        "--use_wandb", "False",
        "--dtype", "float32",
        "--reward_max_workers", "1",
        "--log_level", "DEBUG"
      ],
      "env": {
        "TOKENIZERS_PARALLELISM": "false",
        "WANDB_MODE": "disabled",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      // Inspect the configuration and the dataset without a training run.
      // Put a breakpoint on grpo.py:158 (the GRPOTrainer line). When it stops,
      // inspect `trainer_kwargs`, `extras`, `split.unsupported`, and `dataset[0]`.
      // Then stop the session. You never need to reach the optimizer.
      //
      // To read a REAL config (sdf7b_g32_eh0.3_nohints.yaml and the other 40),
      // use "Unit · config split — every RL config" instead. You cannot launch a
      // real g32 config with one process: TRL needs num_generations (32) to
      // divide per_device (2) × steps_per_generation (4) × processes (1) = 8,
      // and GRPOConfig raises before the dataset is built.
      "name": "Stage 3 · GRPO — stop before training (inspect config + dataset)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/rl/train_reward_hacking.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "args": [
        "--model", "HuggingFaceTB/SmolLM2-135M-Instruct",
        "--config", "training/test/smoke_grpo_cpu.yaml",
        "--task", "humaneval",
        "--system_prompt_key", "please_hack",
        "--hint_style", "code",
        "--hack_mode", "all",
        "--max_samples", "8",
        "--sandbox_type", "local",
        "--use_vllm", "False",
        "--use_wandb", "False",
        "--dtype", "float32",
        "--log_level", "DEBUG"
      ],
      "env": {
        "TOKENIZERS_PARALLELISM": "false",
        "WANDB_MODE": "disabled",
        "PYTHONUNBUFFERED": "1"
      }
    },

    // ─────────────────────────────────────────────────────────────────────────
    // STAGES 1 AND 2 — SFT. One entry point, two data paths.
    // ─────────────────────────────────────────────────────────────────────────
    {
      // Plain text path: <doc> tag removal, packing, loss on all tokens.
      // Breakpoints: sft.py:98 (strip_doc_tags), sft.py:104 (format_plain_text),
      // sft.py:143 (prepare_splits — see the holdout warning).
      "name": "Stage 1 · SDF midtraining (CPU smoke)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/olmo_chat_training/scripts/train_sft.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "args": [
        "--config", "training/test/smoke_midtrain.yaml",
        "--dtype", "float32",
        "--use_wandb", "False",
        "--log_level", "DEBUG"
      ],
      "env": {
        "TOKENIZERS_PARALLELISM": "false",
        "WANDB_MODE": "disabled",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      // Conversational path: chat template, {% generation %} tags, assistant-only loss.
      // Breakpoints: sft.py:117 (format_conversational), sft.py:191
      // (apply_chat_template_file), sft.py:317 (the loss-masking branch).
      //
      // --base_model points at the base model so this runs alone. Change it to
      // ./checkpoints/smoke/midtrain to continue from stage 1.
      "name": "Stage 2 · Instruct SFT (CPU smoke)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/olmo_chat_training/scripts/train_sft.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "args": [
        "--config", "training/test/smoke_instruct_sft.yaml",
        "--base_model", "HuggingFaceTB/SmolLM2-135M-Instruct",
        "--dtype", "float32",
        "--use_wandb", "False",
        "--log_level", "DEBUG"
      ],
      "env": {
        "TOKENIZERS_PARALLELISM": "false",
        "WANDB_MODE": "disabled",
        "PYTHONUNBUFFERED": "1"
      }
    },

    // ─────────────────────────────────────────────────────────────────────────
    // UNIT-LEVEL DEBUGGING — the fastest way into one module.
    // These start in under 20 seconds. Use them before the full training runs.
    // ─────────────────────────────────────────────────────────────────────────
    {
      // The reward path, one hack at a time. This is the best first breakpoint
      // in the whole project. Put one on rewards.py:158 (_evaluate_one) and one
      // on code_sandbox.py:230 (run_tests_with_config).
      "name": "Unit · reward path — one hack executes",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "tests/test_training.py",
        "-k", "test_hack_works_when_enabled",
        "-s", "-v"
      ],
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // The mitigation side. The same hacks, but the problem closes them.
      "name": "Unit · reward path — the mitigations close the hacks",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "tests/test_training.py",
        "-k", "test_hack_is_mitigated_when_disabled",
        "-s", "-v"
      ],
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // Nine reward functions, one pytest run. Breakpoint: rewards.py:136 (the
      // cache check). Run the configuration and watch call 1 do the work and
      // calls 2 to 9 read the cache.
      "name": "Unit · nine reward functions share one sandbox run",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "tests/test_training.py",
        "-k", "test_reward_funcs_share_one_sandbox_run",
        "-s", "-v"
      ],
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // The configuration split. Breakpoint: config.py:129 (the key loop).
      // Watch each key go to trainer_kwargs, extras, or unsupported.
      "name": "Unit · config split — every RL config",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "tests/test_training.py",
        "-k", "test_rl_configs_are_consumable",
        "-s", "-v"
      ],
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // The chat template and the loss mask. Breakpoint: sft.py:191.
      // Inspect `encoded["assistant_masks"]` to see which tokens the loss uses.
      "name": "Unit · chat template masks the assistant turn",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "tests/test_training.py",
        "-k", "test_chat_templates_mask_to_assistant_turns",
        "-s", "-v"
      ],
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      "name": "Unit · all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": ["tests/test_training.py", "-v"],
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // Debug the file that is open in the editor. Useful for a scratch script.
      "name": "Unit · current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "TOKENIZERS_PARALLELISM": "false",
        "PYTHONUNBUFFERED": "1"
      }
    },

    // ─────────────────────────────────────────────────────────────────────────
    // DATA
    // ─────────────────────────────────────────────────────────────────────────
    {
      // SDF dilution. --ratio 0.0 keeps only the synthetic documents, which is
      // the setting of the main results. Use 0.99 for the paper's 1:99 mixture.
      "name": "Data · mix_datasets (SDF dilution)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/olmo_chat_training/scripts/mix_datasets.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--output_dir", "./datasets/debug_sdf_0pct",
        "--ratio", "0.0",
        "--test_size", "20",
        "--log_level", "DEBUG"
      ],
      "env": { "PYTHONUNBUFFERED": "1" }
    },

    // ─────────────────────────────────────────────────────────────────────────
    // EVALUATION — these need a vLLM server on port 8000.
    // Start one first. See guide file 16, Phase 1.
    // ─────────────────────────────────────────────────────────────────────────
    {
      // Reward-hacking rate. This needs no API key. It needs a sandbox.
      "name": "Eval · reward hacking (CodeContests)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_codecontests_reward_hacking_eval.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--model", "openai/step0",
        "--model-base-url", "http://localhost:8000/v1",
        "--api-key", "inspectai",
        "--num-samples", "4",
        "--temperature", "1.0",
        "--system-prompt-suffix-variant", "no_hints",
        "--sandbox-type", "local",
        "--max-connections", "2",
        "--output-dir", "results/debug/cc_rh/"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "INSPECT_TELEMETRY": "",
        "INSPECT_API_KEY_OVERRIDE": ""
      }
    },
    {
      // Misalignment evaluations. This needs ANTHROPIC_API_KEY for the judge.
      // frame_colleague is the evaluation that carries most of the signal.
      "name": "Eval · misalignment (frame_colleague)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_misalignment_evals.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--model", "openai/step0",
        "--model-base-url", "http://localhost:8000/v1",
        "--api-key", "inspectai",
        "--evals", "frame_colleague",
        "--num-samples", "2",
        "--max-connections", "2",
        "--output-dir", "results/debug/mgs/"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "INSPECT_TELEMETRY": "",
        "INSPECT_API_KEY_OVERRIDE": ""
      }
    },
    {
      // Hack-knowledge evaluation. Note the underscore flags: this script uses fire.
      "name": "Eval · hack knowledge (fire — underscore flags)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/hack_knowledge_eval.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--model", "openai/step0",
        "--model_base_url", "http://localhost:8000/v1",
        "--api_key", "inspectai",
        "--n", "2",
        "--prompts", "no_holds_barred",
        "--output_dir", "results/debug/hack_knowledge/"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "INSPECT_TELEMETRY": "",
        "INSPECT_API_KEY_OVERRIDE": ""
      }
    },

    // ─────────────────────────────────────────────────────────────────────────
    // ANALYSIS — the replication study in
    //   ../p292_apply_for_uk_aisi_job/research_interview/docs/report_logs/
    //
    // Every configuration below re-creates one figure or one table from those
    // numbered log files. The code is in analysis/, the inputs are already on
    // disk (results/, logs/, and the HuggingFace cache), so all of them run on
    // the CPU with no server and no API key.
    //
    // Read the log file first, then run the matching configuration:
    //   03-rollout-label-replication.md  -> "Analysis · A1 ..."
    //   04-training-curves.md            -> "Analysis · A2 ..."
    //   05-track-b-hack-knowledge.md     -> "Analysis · B ..."
    //   06-track-c-causal-control.md     -> "Analysis · C ..."
    //   08-track-d-misalignment.md       -> "Analysis · D ..."
    //   09-track-e-faithfulness-...md    -> "Analysis · E ..."
    //
    // Output goes to figures/debug/ and results/debug/, NOT to the committed
    // figures/replication/. Compare the two to confirm a run reproduced.
    //
    // All the analysis scripts use fire, so the first argument is the
    // subcommand `run` and the flags carry underscores.
    // ─────────────────────────────────────────────────────────────────────────
    {
      // Track A1 — recompute eight reward channels from the authors' released
      // rollouts with this repo's own detectors, then compare with their labels.
      // The report gets 100.0000% agreement over 51,427 rollouts.
      //
      // Breakpoints: replicate_rollout_labels.py:recompute (one rollout, all
      // eight channels) and :completion_text (the three-column split that the
      // report says had to be understood first). Inspect `hack_config` — a hack
      // counts only where the problem left it exploitable.
      //
      // --limit 200 keeps the loop short. Drop it for the full 51,456 rows
      // (about 6 minutes; the datasets are already in the HuggingFace cache).
      "name": "Analysis · A1 — replicate the released rollout labels (fast)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analysis/replicate_rollout_labels.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "run",
        "--limit", "200",
        "--text_field", "completion",
        "--output_dir", "results/debug/rollout_replication"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "HF_HUB_OFFLINE": "1",
        "TOKENIZERS_PARALLELISM": "false"
      }
    },
    {
      // The same run scored on the wrong column, kept because the failure is
      // instructive. `response` holds only the text after </thinking>, so the
      // three hack detectors still mostly fire but thinking_format_ok and
      // cot_mentions_hack collapse to 2% and 45%. Report 03, table 2.
      "name": "Analysis · A1 — the deliberate failure (--text_field response)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analysis/replicate_rollout_labels.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "run",
        "--limit", "200",
        "--text_field", "response",
        "--output_dir", "results/debug/rollout_replication"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "HF_HUB_OFFLINE": "1",
        "TOKENIZERS_PARALLELISM": "false"
      }
    },
    {
      // Track A2 — figures 01, 02 and 03. Reads the two released rollout
      // datasets from the HuggingFace cache, so it needs no network.
      //
      // Breakpoint: plot_training_curves.py:load_steps. The line to watch is
      // the `order` dict: `epoch` is NOT the time axis (it is inspect's repeat
      // index 1..16), so the step number comes from sorting `source_eval_file`
      // by its ISO timestamp. Inspect `steps` afterwards — 401 rows for
      // beta=0.0 and 403 for beta=0.02, 64 rollouts each.
      //
      // Takes about 2 minutes: both datasets load in full.
      "name": "Analysis · A2 — training curves, figs 01-03 (substitution, hack choice, CoT)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analysis/plot_training_curves.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": ["run", "--output_dir", "figures/debug"],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "HF_HUB_OFFLINE": "1",
        "TOKENIZERS_PARALLELISM": "false"
      }
    },
    {
      // Track B — fig 04, hack knowledge after SDF midtraining.
      // Scores the responses already collected in results/hack_knowledge_sdf/.
      //
      // Breakpoint: plot_hack_knowledge.py:score_all. It scores each response
      // twice — with the shipped pattern list and with a corrected one. The
      // shipped list for "Early exit (os._exit / sys.exit)" matches only
      // os._exit, while the models say sys.exit, so the shipped scorer reports
      // 0.0% for every model. That is the finding of report 05.
      "name": "Analysis · B — hack knowledge, fig 04 (the sys.exit / os._exit gap)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analysis/plot_hack_knowledge.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "run",
        "--results_dir", "results/hack_knowledge_sdf",
        "--output_dir", "figures/debug"
      ],
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // Track C — fig 05, the causal control: 95.3% hacking with the exploits
      // open against 0.0000% with them mitigated.
      //
      // --log is set on purpose. The script's default (logs/trackc.log) is the
      // abandoned 1.5B attempt, which never hacked. The figure in report 06
      // comes from the 7B 150-step run below.
      //
      // Breakpoint: plot_trackc_control.py:parse_log. The parser splits the log
      // on the `arm: hack_mode=...` banners that run_trackc_control.sh prints,
      // then pulls the metric dict TRL writes for each step. The file is 912 MB,
      // so the parse takes about a minute.
      //
      // The two arguments are positional, and that is deliberate. The flag form
      // `--log <path>` crashes the PNG export: kaleido pulls in logistro, which
      // parses sys.argv itself and reports
      //   error: ambiguous option: --log could match --logistro-level
      // The HTML is written before that point, the PNG is not. Positional
      // arguments never reach logistro's parser.
      "name": "Analysis · C — causal control, fig 05 (hacks open vs mitigated)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analysis/plot_trackc_control.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": ["run", "logs/trackc_7b_s150.log", "figures/debug"],
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // Track D — fig 06, hacking against misalignment over the same steps.
      // The null result: hacking went 0 -> 95%, MGS did not move (p = 0.21).
      //
      // Breakpoints: plot_misalignment_trajectory.py:hacking_curve (the same
      // log parse as Track C) and :load_mgs (reads mgs_*.json for each served
      // checkpoint). `fc_root` is the n=50 re-measurement of frame_colleague —
      // the eval that looked Bonferroni-significant at n=15 and then vanished.
      "name": "Analysis · D — misalignment trajectory, fig 06 (the null result)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analysis/plot_misalignment_trajectory.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "run",
        "--trackc_log", "logs/trackc_7b_s150.log",
        "--mgs_root", "results/misalignment_trajectory",
        "--fc_root", "results/frame_colleague_n50",
        "--output_dir", "figures/debug"
      ],
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // Track D — fig 10. The same null, one panel per eval, to show that the
      // flat aggregate is not an averaging artifact: monitor_disruption, which
      // carried the whole 32B effect in Track E, is flat here too.
      // Fast: it only reads six small JSON files.
      "name": "Analysis · D — per-eval breakdown, fig 10 (the null holds per eval)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analysis/plot_trackd_per_eval.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "run",
        "--root", "results/misalignment_trajectory",
        "--output_dir", "figures/debug"
      ],
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // Track E — fig 07. The follow-up paper's Figure 7 claim, tested on the
      // two released 32B organisms under two independent judges.
      //
      // Breakpoint: plot_faithfulness_misalignment.py:load. Note the comment on
      // the MGS line: MGS is the mean of the per-eval rates, not the pooled
      // rate, and the two differ because betley has 56 items and not 100.
      "name": "Analysis · E — faithful vs unfaithful CoT, fig 07",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analysis/plot_faithfulness_misalignment.py",
      "python": "${workspaceFolder}/.venv/bin/python",
