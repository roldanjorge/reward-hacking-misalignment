      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "run",
        "--opus_root", "results/olmo32b_n100_opus",
        "--legacy_root", "results/olmo32b_n100_legacy",
        "--output_dir", "figures/debug"
      ],
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // Track E — fig 08. Where the signal actually is: two of six evals carry
      // all of it, and four sit at zero, so the aggregate MGS dilutes the
      // effect about threefold.
      "name": "Analysis · E — per-eval breakdown, fig 08 (where the signal is)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analysis/plot_per_eval_breakdown.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "run",
        "--opus_root", "results/olmo32b_n100_opus",
        "--legacy_root", "results/olmo32b_n100_legacy",
        "--output_dir", "figures/debug"
      ],
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // Track E — fig 09. One point per (model, eval) cell, strict judge
      // against legacy judge. Off-diagonal points mean the two judges do not
      // measure the same thing — they disagree on exactly the two evals that
      // carry the signal.
      "name": "Analysis · E — judge agreement, fig 09",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analysis/plot_judge_agreement.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "run",
        "--opus_root", "results/olmo32b_n100_opus",
        "--legacy_root", "results/olmo32b_n100_legacy",
        "--output_dir", "figures/debug"
      ],
      "env": { "PYTHONUNBUFFERED": "1" }
    },

    // ─────────────────────────────────────────────────────────────────────────
    // COLLECT — the runs that produced the data the analysis reads.
    // These need a GPU. The shell scripts run every model in a loop; each
    // configuration below is one model of that loop, so it can be stepped
    // through. Start the matching server first, in a terminal:
    //
    //   bash analysis/serve_sdf_lora.sh      -> Collect · B
    //   bash analysis/serve_trackc_ckpts.sh  -> Collect · D
    //   bash analysis/serve_olmo31_rl.sh     -> Collect · E
    //
    // The two misalignment configurations read ANTHROPIC_API_KEY from .env
    // through "envFile": the Opus judge is a paid API call.
    // ─────────────────────────────────────────────────────────────────────────
    {
      // Track B, one model of five. Regex scoring, no API key needed.
      // Breakpoint: hack_knowledge_eval.py:_query_model. The report found this
      // function dropped the caller's --model and used models.list()[0], which
      // would have sent every request to the base model.
      // Also see :_check_hacks (line ~120) — the pattern list that omits sys.exit.
      "name": "Collect · B — hack knowledge, one model (needs serve_sdf_lora.sh)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/hack_knowledge_eval.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "run",
        "--model", "openai/sdf-ckpt-1500",
        "--model_base_url", "http://localhost:8000/v1",
        "--api_key", "inspectai",
        "--n", "2",
        "--prompts", "no_holds_barred,pass_without_solving",
        "--output_dir", "results/debug/hack_knowledge_sdf/sdf-ckpt-1500"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "INSPECT_TELEMETRY": "",
        "INSPECT_API_KEY_OVERRIDE": ""
      }
    },
    {
      // Track D, one checkpoint of six. frame_colleague is the eval whose n=15
      // spike (6/15) failed to replicate at n=50 (6/50).
      // --num-samples 2 keeps the judge bill near zero while stepping.
      "name": "Collect · D — misalignment, one checkpoint (needs serve_trackc_ckpts.sh)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_misalignment_evals.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "args": [
        "--model", "openai/rl-step-150",
        "--model-base-url", "http://localhost:8000/v1",
        "--api-key", "inspectai",
        "--evals", "frame_colleague",
        "--num-samples", "2",
        "--max-connections", "2",
        "--opus-judge",
        "--output-dir", "results/debug/misalignment_trajectory/rl-step-150"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "INSPECT_TELEMETRY": "",
        "INSPECT_API_KEY_OVERRIDE": ""
      }
    },
    {
      // Track E, one model of three, on the eval that carries the effect.
      // Swap --opus-judge for --legacy-judges to run the other arm: the two
      // judges disagree, and report 09 treats that as a finding, not a bug.
      "name": "Collect · E — misalignment on the 32B organisms (needs serve_olmo31_rl.sh)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_misalignment_evals.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "args": [
        "--model", "openai/rh-kl0.0-faithful",
        "--model-base-url", "http://localhost:8000/v1",
        "--api-key", "inspectai",
        "--evals", "monitor_disruption",
        "--num-samples", "2",
        "--max-connections", "2",
        "--opus-judge",
        "--output-dir", "results/debug/olmo32b_opus/rh-kl0.0-faithful"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "INSPECT_TELEMETRY": "",
        "INSPECT_API_KEY_OVERRIDE": ""
      }
    },
    {
      // Track C treatment arm — the GRPO run that produced logs/trackc_7b_s150.log
      // and the checkpoints Track D evaluates. Needs an 80 GB GPU and about
      // 5 hours for the full 150 steps. Hacking ignites near step 86.
      //
      // The control arm is the next configuration. The two differ in --hack_mode
      // and nothing else, which is what makes the comparison causal.
      "name": "Collect · C — GRPO treatment arm (--hack_mode all, GPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/rl/train_reward_hacking.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "args": [
        "--model", "Qwen/Qwen2.5-Coder-7B-Instruct",
        "--config", "training/test/trackc_cc_7b.yaml",
        "--task", "codecontests",
        "--system_prompt_key", "please_hack",
        "--hint_style", "code",
        "--hack_mode", "all",
        "--sandbox_type", "docker",
        "--use_vllm", "True",
        "--vllm_mode", "colocate",
        "--output_dir", "./checkpoints/debug/trackc_hack_all",
        "--run_name", "debug-cc-hack_all",
        "--use_wandb", "False",
        "--seed", "0"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "TOKENIZERS_PARALLELISM": "false",
        "WANDB_MODE": "disabled"
      }
    },
    {
      // Track C control arm. Same model, same please_hack prompt with the hack
      // recipes spelled out, same seed — and every exploit mitigated. Across
      // 4,800 rollouts reward_hacked never left 0.0000.
      "name": "Collect · C — GRPO control arm (--hack_mode none, GPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/rl/train_reward_hacking.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "args": [
        "--model", "Qwen/Qwen2.5-Coder-7B-Instruct",
        "--config", "training/test/trackc_cc_7b.yaml",
        "--task", "codecontests",
        "--system_prompt_key", "please_hack",
        "--hint_style", "code",
        "--hack_mode", "none",
        "--sandbox_type", "docker",
        "--use_vllm", "True",
        "--vllm_mode", "colocate",
        "--output_dir", "./checkpoints/debug/trackc_hack_none",
        "--run_name", "debug-cc-hack_none",
        "--use_wandb", "False",
        "--seed", "0"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "TOKENIZERS_PARALLELISM": "false",
        "WANDB_MODE": "disabled"
      }
    },

    // ─────────────────────────────────────────────────────────────────────────
    // ATTACH — debug a job that already runs (tmux, nohup, or Slurm).
