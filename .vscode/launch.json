      "name": "Analysis · every figure (Tracks A-E)",
      "configurations": [
        "Analysis · A2 — training curves, figs 01-03 (substitution, hack choice, CoT)",
        "Analysis · B — hack knowledge, fig 04 (the sys.exit / os._exit gap)",
        "Analysis · C — causal control, fig 05 (hacks open vs mitigated)",
        "Analysis · D — misalignment trajectory, fig 06 (the null result)",
        "Analysis · D — per-eval breakdown, fig 10 (the null holds per eval)",
        "Analysis · E — faithful vs unfaithful CoT, fig 07",
        "Analysis · E — per-eval breakdown, fig 08 (where the signal is)",
        "Analysis · E — judge agreement, fig 09"
      ],
      "stopAll": true
    }
  ]
}
